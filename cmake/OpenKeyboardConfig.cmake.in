@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(QT NAMES Qt6 Qt5 COMPONENTS Core Quick Gui)
find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS Core Quick Gui)

include("${CMAKE_CURRENT_LIST_DIR}/OpenKeyboardTargets.cmake")

set(OpenKeyboard_QML_DIR "@PACKAGE_CMAKE_INSTALL_QMLDIR@")
set(OpenKeyboard_QML_IMPORT_PATH "${OpenKeyboard_QML_DIR}/..")
check_required_components(OpenKeyboard)
